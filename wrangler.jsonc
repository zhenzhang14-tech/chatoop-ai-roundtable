{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatoop-ai-roundtable",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "MOCK_MODE": "false",
    "ALLOW_ANONYMOUS": "false",
    "ALLOWED_ORIGINS": "",
    "ROUND_TABLE_MODELS": "openai/gpt-4o-mini,google/gemini-2.0-flash-001,deepseek/deepseek-chat",
  },
}
